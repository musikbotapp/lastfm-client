{
  "name": "@musikbotapp/lastfm-client",
  "version": "1.0.0",
  "description": "Zero-dependency TypeScript client for the Last.fm API with normalized responses and rate limiting.",
  "license": "MIT",
  "author": "musikbotapp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musikbotapp/lastfm-client.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint-plugin-unicorn": "^71.1.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
